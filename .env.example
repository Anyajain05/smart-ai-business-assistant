APP_NAME="Smart AI Business Assistant"
APP_SECRET="change-me-before-production"
DATABASE_URL="data/app.db"
UPLOAD_DIR="uploads"
CHROMA_PATH="data/chroma"
ACCESS_TOKEN_MINUTES=480
ALLOW_DEMO_BOOTSTRAP=true

# Optional: Redis for RAG query caching (docker-compose sets redis://redis:6379/0)
REDIS_URL=

# Optional: OpenAI for embeddings (Chroma) + chat + vision
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: Hugging Face inference for chat
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=google/flan-t5-large

# Force LLM even without retrieval context (true/false)
FORCE_LLM=false
